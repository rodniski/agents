#!/usr/bin/env bash
set -euo pipefail

CANON="${HOME}/.agents"
SKILLS="${CANON}/skills"
AGENTS="${CANON}/AGENTS.md"
CURSOR_RULES="${HOME}/.cursor/rules"
CURSOR_RULE="${CURSOR_RULES}/gui-agents.mdc"

mkdir -p "$SKILLS" "$CURSOR_RULES" "${HOME}/.claude" "${HOME}/.codex" "${HOME}/.cursor"
test -f "$AGENTS" || { echo "missing $AGENTS"; exit 1; }

# Skills minhas que vivem em repo próprio: clona em own/ se faltar.
# Localmente own/<nome> pode ser symlink pro checkout de desenvolvimento.
for repo in rodniski/humanizing; do
  dest="${CANON}/own/${repo#*/}"
  [[ -e "$dest" ]] || git clone -q "https://github.com/${repo}.git" "$dest"
done

# skills/ é só índice plano pros harnesses (eles não descem em subpasta).
# Fonte real: own/<nome> (minhas) e vendor/[<fonte>/]<nome> (terceiras).
# Recria os symlinks relativos, poda os quebrados e avisa de pasta real
# largada em skills/ (ex.: `npx skills add --copy`), que deve ir pra vendor/.
for link in "$SKILLS"/*; do
  if [[ -L "$link" && ! -e "$link" ]]; then rm "$link"; fi
done
for dir in "$CANON"/own/*/ "$CANON"/vendor/*/ "$CANON"/vendor/*/*/; do
  test -f "${dir}SKILL.md" || continue
  rel="${dir#"$CANON"/}"
  ln -sfn "../${rel%/}" "${SKILLS}/$(basename "$dir")"
done
for dir in "$SKILLS"/*/; do
  name="$(basename "$dir")"
  [[ -L "${dir%/}" || "$name" == synced ]] && continue
  echo "aviso: skills/${name} é pasta real; mova pra own/ ou vendor/<fonte>/"
done

ln -sfn "$SKILLS" "${HOME}/.claude/skills"
ln -sfn "$SKILLS" "${HOME}/.cursor/skills"
ln -sfn "$AGENTS" "${HOME}/.claude/CLAUDE.md"
ln -sfn "$AGENTS" "${HOME}/.codex/AGENTS.md"

# Cursor não tem CURSOR.md nem AGENTS.md global. Link via rule alwaysApply + @arquivo.
cat > "$CURSOR_RULE" <<EOF
---
description: Preferências pessoais do Gui (canônico em ~/.agents/AGENTS.md)
alwaysApply: true
---

Siga integralmente as preferências pessoais em:

@${AGENTS}

Em conflito de domínio/produto, o \`AGENTS.md\` do repositório (e Project Rules) vencem este arquivo.
EOF

echo "Redirects OK:"
printf '  %s -> %s\n' \
  ~/.claude/skills "$(readlink ~/.claude/skills)" \
  ~/.cursor/skills "$(readlink ~/.cursor/skills)" \
  ~/.claude/CLAUDE.md "$(readlink ~/.claude/CLAUDE.md)" \
  ~/.codex/AGENTS.md "$(readlink ~/.codex/AGENTS.md)"
echo "  ~/.cursor/rules/gui-agents.mdc -> @${AGENTS} (alwaysApply)"
